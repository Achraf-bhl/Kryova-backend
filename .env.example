# Copy to `.env` and fill in. `.env` is gitignored; this file is the tracked
# documentation of every setting the service reads. Anything not set here falls
# back to the default in `app/core/config.py`.
#
# `.env.local` is read after `.env` and wins for any key it sets -- a convenient
# place for a per-machine provider API key.

# --- Database: Neon Postgres (required) -------------------------------------
# Paste the connection string straight from the Neon console; the app rewrites
# it onto the psycopg 3 driver itself. A non-PostgreSQL URL is refused at
# startup.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Use the pooled (-pooler) endpoint. Neon drops idle connections, so recycle
# first: pool_recycle must stay below Neon's idle timeout.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=280

# The schema the application's tables live in. Every statement is compiled
# schema-qualified against this; never `SET search_path` on a pooled endpoint.
DB_SCHEMA=public

# --- Tests -------------------------------------------------------------------
# Where `pytest` is allowed to create and drop tables. Leave UNSET to run
# against an in-memory SQLite database (what CI does). If you set it, it must
# not resolve to the same host and database as DATABASE_URL -- the suite refuses
# to run against the application's own database.
# TEST_DATABASE_URL=postgresql://localhost:5432/kryova_test

# Schema used inside TEST_DATABASE_URL when it is a PostgreSQL URL.
TEST_SCHEMA=kryova_test

# --- Auth --------------------------------------------------------------------
# ENVIRONMENT=production refuses to boot on a default/short SECRET_KEY, on
# COOKIE_SECURE=false, or on a plaintext http:// CORS origin. It also turns off
# /docs, /redoc and the OpenAPI document, and switches logging to JSON.
ENVIRONMENT=development

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs every access and refresh token. Left at the default, anyone with a copy
# of this source can mint a valid token for any user.
SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# true in production, so session cookies are only sent over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# --- Rate limiting -----------------------------------------------------------
# Redis makes auth rate limits shared across workers. Unset falls back to a
# per-process in-memory limiter, which in production means the effective limit
# is multiplied by the worker count.
# REDIS_URL=redis://localhost:6379/0

# Only enable TRUST_PROXY_HEADERS when EVERY request arrives through a reverse
# proxy that appends to X-Forwarded-For. Enabled without one, any client can
# forge its own address and escape the rate limiter entirely.
TRUST_PROXY_HEADERS=false
# How many proxies append, counted from the right-hand end of the header.
TRUSTED_PROXY_COUNT=1

# --- Local media store -------------------------------------------------------
# Every heavy file (CAD, meshes, result fields, FAISS indexes) stays on this
# machine. Only small metadata rows go to Neon.
MEDIA_ROOT=./media_data
MEDIA_CHUNK_SIZE=8388608
MAX_MEDIA_BYTES=2147483648
UPLOAD_SESSION_TTL_HOURS=24
MAX_UPLOAD_BYTES=209715200
# The ceiling on a client-chosen resumable-upload chunk size is not settable
# here: it is a request-schema constraint (MAX_UPLOAD_CHUNK_BYTES in
# app/core/config.py, 64 MiB), and Pydantic bakes those in at import time.
# Geometry extensions accepted at upload. Only formats the mesher can actually
# open belong here -- CATIA natives are deliberately absent, because stock
# OpenCASCADE cannot read them.
ALLOWED_GEOMETRY_FORMATS=["step","stp","iges","igs","stl"]

# --- Background jobs ---------------------------------------------------------
# "threadpool" (default) or "inline". Inline runs meshing and solving on the
# request thread, which is what a --reload dev server wants. There is no
# distributed backend; an unknown value is refused at startup.
JOB_QUEUE_BACKEND=threadpool
INLINE_JOBS=false
JOB_WORKERS=2

# --- Analysis limits ---------------------------------------------------------
# Refuse a mesh larger than this, so one upload cannot eat the machine.
MAX_ELEMENTS=400000
# Element-size floor, as a divisor of the part's bounding-box diagonal. An
# element size below diagonal/this is refused before meshing starts.
MAX_ELEMENTS_ALONG_DIAGONAL=2000
# Queued or running simulations one user may hold at once.
MAX_CONCURRENT_SIMULATIONS_PER_USER=3

# --- AI ----------------------------------------------------------------------
# Which model answers is your choice. The default is LOCAL: your CAD geometry
# and load cases are proprietary IP and are never posted to a third party
# unless you opt in. The AI endpoints report themselves unavailable when the
# provider is unreachable; nothing else in the app is affected.
#
#   ollama            local, no key, works offline           (default)
#   anthropic         hosted Claude -- also `pip install anthropic`
#   nvidia            NVIDIA NIM, build.nvidia.com -- free developer tier
#   openai_compatible OpenAI / LM Studio / vLLM / llama.cpp / Groq / OpenRouter
AI_PROVIDER=ollama

# ollama            -> any pulled model, e.g. qwen2.5-coder:7b, llama3.1:8b
# anthropic         -> claude-opus-5, claude-sonnet-5, claude-haiku-4-5
# nvidia            -> nvidia/nemotron-3.5-lightning-30b-a3b (the default),
#                      or any id listed by GET /v1/models on that endpoint
# openai_compatible -> whatever that server serves
AI_MODEL=qwen2.5-coder:7b

# ollama            -> http://localhost:11434 (the default; leave unset)
# nvidia            -> https://integrate.api.nvidia.com/v1 (the default;
#                      set only to reach a self-hosted NIM container)
# openai_compatible -> REQUIRED, e.g. http://localhost:1234/v1 for LM Studio
# AI_BASE_URL=

# Needed by anthropic and nvidia (an NVIDIA key looks like 'nvapi-...', free
# from build.nvidia.com); usually unnecessary for a local openai_compatible
# server.
# Put real keys in .env.local, never here.
# AI_API_KEY=

# Reasoning depth per task. Interpreting a result is judgement; parsing a
# sentence into a load case is near-mechanical.
AI_EFFORT_INTERPRET=high
AI_EFFORT_PARSE=low
AI_MAX_TOKENS=8000
# A 7B model on CPU can genuinely take a minute.
AI_TIMEOUT_SECONDS=120

# --- NVIDIA only -------------------------------------------------------------
# Nemotron models reason before answering and return the chain of thought in a
# separate `reasoning_content` field. Thinking is what makes the agent pick the
# right CATIA operation out of 201; turn it off only if latency matters more
# than getting the part right. Structured output (parsing a sentence into a load
# case) always runs with it off regardless -- measured at 890 completion tokens
# and 20.2s with thinking versus ~20 tokens and 1.8s without, for the same
# answer -- so this setting only affects the agent loop.
AI_NVIDIA_THINKING=true
# Ceiling on reasoning tokens per call, billed as output. Left unbounded, one of
# these models will spend three thousand tokens deliberating over a trivial
# question.
AI_NVIDIA_REASONING_BUDGET=4096

# Conversation history sent back to the model. Older turns beyond
# AI_MAX_CONTEXT_MESSAGES are dropped; summarisation kicks in earlier, at
# AI_SUMMARISE_AFTER_MESSAGES, so nothing is lost outright.
AI_MAX_CONTEXT_MESSAGES=40
AI_SUMMARISE_AFTER_MESSAGES=30

# --- Reference manuals -------------------------------------------------------
# The assistant can consult the CATIA and FEA documentation held on this
# machine instead of answering about CATIA from memory. Indexing is local and
# needs no model, no API key and no network -- which is why it works the same
# under every AI_PROVIDER above.
#
# Put PDFs in data/bm25/sources/ and build the index:
#   python -m app.retrieval.build            # build (or rebuild)
#   python -m app.retrieval.build --check    # is it there, is it current
#   python -m app.retrieval.build --query X  # see what the assistant would find
#
# Off removes the lookup from the assistant's vocabulary entirely, rather than
# leaving it to call something that will always come back empty. With no index
# built, the effect is the same and nothing has to be switched off by hand.
KNOWLEDGE_ENABLED=true

# Where the manuals and the built index live. `sources/` is scanned
# recursively; the parent `data/` is scanned too, so documents already sitting
# there are picked up without moving them.
# KNOWLEDGE_ROOT=./data/bm25

# Passages returned per lookup. More crowds the conversation out of the context
# window; fewer and a broad question misses the paragraph it needed.
KNOWLEDGE_MAX_PASSAGES=5

# --- CATIA V5 structured reference -------------------------------------------
# The knowledge base in `app/catia_kb`: every workbench, command, dialog field,
# file format, Tools>Options setting, error message, aerospace term and product
# trigram, plus the command names in the interface languages the manuals cover.
#
# Unlike the manuals above this ships in the code, so it is always present --
# these switches exist for measuring its effect, not for deployments that lack
# the data. Off is a strictly worse assistant, not a broken one.
CATIA_KNOWLEDGE_ENABLED=true

# Whether a turn carries a few lines naming the CATIA terms found in the user's
# message: workbench, exact menu path, the name their interface actually shows.
# Costs tokens only on turns that name something, and is what lets a small local
# model get the menu path right without first deciding to call a tool.
CATIA_KNOWLEDGE_BRIEF_ENABLED=true

# Whether a documentation search is widened with the same term in the other
# languages the manuals are written in. Half this corpus is French, so an
# English question for "draft angle" cannot otherwise reach the pages that call
# it "dépouille". Additive and capped; the original words keep their weight.
CATIA_KNOWLEDGE_EXPAND_QUERIES=true

# --- CATIA desktop bridge ----------------------------------------------------
# See docs/CATIA_BRIDGE_PROTOCOL.md. The daemon dials OUT to this service; there
# is no inbound port on the engineer's machine.
# Off removes the CATIA tools from the agent's vocabulary entirely.
CATIA_ENABLED=true
# One in-flight call per device (CATIA automation is single-threaded), so a
# wedged call blocks that device's queue until it times out.
CATIA_CALL_TIMEOUT_S=30
# A STEP export re-tessellates the whole part and legitimately takes minutes.
CATIA_EXPORT_TIMEOUT_S=180
# Device tokens are long-lived: an engineer pairs the workstation once. Only the
# SHA-256 of the token is stored server-side.
CATIA_DEVICE_TOKEN_TTL_DAYS=365
# Pairing codes are single-use and read off a screen, so the window is the
# security boundary.
CATIA_PAIRING_CODE_TTL_MINUTES=10
# Per-device operation ceiling, mirroring the daemon's own limit.
CATIA_OPS_PER_MINUTE=60
# Single-machine install: start and pair the bridge daemon on this host rather
# than making the engineer read a pairing code off their own screen and type it
# into a terminal on the same machine. Set false for a hosted deployment, where
# the server is not the user's workstation and must not spawn processes for an
# account. Windows only; ignored elsewhere.
CATIA_LOCAL_BRIDGE=true
# Where that locally started daemon dials back to. It is this server, so the
# only reason to change it is a non-default bind port.
CATIA_LOCAL_BRIDGE_SERVER=http://127.0.0.1:8000
