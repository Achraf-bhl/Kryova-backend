# Environment variables
#
# `.env` holds real credentials and is NEVER committed. It was, once, with live
# Neon credentials in it -- those are in the public history and have to be
# rotated, not just removed. `.env.example` is the tracked file: it documents
# every setting with placeholders.
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
venv/
.venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases
*.db
*.sqlite3

# Local heavy-file store (CAD, meshes, result fields, vector indexes)
media_data/

# Third-party reference material, not source
data/

# Logs
*.log

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
